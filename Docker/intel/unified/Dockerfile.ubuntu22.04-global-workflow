RUN cd /opt && rm -rf container-scripts && git clone https://github.com/noaa-epic/container-scripts
RUN source /usr/lmod/lmod/init/bash && \
    export PATH=/opt/intel/oneapi/compiler/2024.0/bin:/opt/intel/oneapi/compiler/2023.2.3/linux/bin/intel64:$PATH && \
    export HOMEgfs=$PWD && \
    export MACHINE_ID=containerized && \
    export compiler=intel && \
    export CMAKE_OPTS="-DLINK_W3EMC=NO" && \
    export USE_BUFR4=ON && \
    export CONTAINER_MODULE_PATH=/opt/spack-stack/spack-stack-1.6.0/envs/unified-env/install/modulefiles/Core && \
    export PATH=/opt/intel/oneapi/compiler/2024.0/bin:/opt/intel/oneapi/compiler/2023.2.3/linux/bin/intel64:$PATH && \
    source ./versions/build.containerized.ver && \
    module use $PWD/sorc/gdas.cd/modulefiles && module load GDAS/containerized.intel && module list && \
    cd sorc && \
    export GDASAPP_TESTDATA=/opt/spack-stack/spack-stack-1.6.0/envs/unified-env/install/intel/2021.10.0/crtm-fix-2.4.0.1_emc-bf2ggtz/fix && \
    ./build_gdas.sh
RUN cd sorc && \
    sed -i '/BINDDIRS/d' /opt/container-scripts/dot-externalize.sh && \
    sed -i '/IMAGE/d' /opt/container-scripts/dot-externalize.sh && \
    sed -i 's/BASEFILE|$pathdir/BASEFILE|HOMEgfs/g' /opt/container-scripts/dot-externalize.sh && \
    source /opt/spack-stack/spack-stack-1.6.0/.bashenv && \
    module load cdo nco prod_util wgrib2 && \
    cd .. && \
    cp $cdo_ROOT/bin/* $PWD/exec && \
    cp $nco_ROOT/bin/* $PWD/exec && \
    cp $wgrib2_ROOT/bin/* $PWD/exec && \
    cp $prod_util_ROOT/bin/mdate $PWD/exec && \
    cp $prod_util_ROOT/bin/ndate $PWD/exec && \
    cp $prod_util_ROOT/bin/nhour $PWD/exec && \
    cp $prod_util_ROOT/bin/fsync_file $PWD/exec && \
    /opt/container-scripts/dot-externalize.sh $PWD/exec/* && \
    # copy in all the scripts from prod_util
    for list in $prod_util_ROOT/bin/*; do textfile=$(file $list | grep text); if [[ -n "$textfile" ]] ; then cp $list $PWD/exec; fi ; done
    
