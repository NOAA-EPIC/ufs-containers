#!/bin/bash
set -x
export SINGULARITYENV_FI_PROVIDER=tcp
export SINGULARITY_SHELL=/bin/bash
img="IMAGE"
cmd=$(basename "$0")
arg="$@"
echo running: PATH_TO_SINGULARITY exec --env-file SINGULARITY_WORKING_DIR/ufs-srweather-app/container-scripts/srw.env -B /BINDDIR -B /LOCDIR "${img}" $cmd $arg
PATH_TO_SINGULARITY exec --env-file SINGULARITY_WORKING_DIR/ufs-srweather-app/container-scripts/srw.env -B /BINDDIR -B /LOCDIR "${img}" $cmd $arg

